{
  "name": "yoyo-clicker",
  "displayName": "YoYo Clicker",
  "version": "0.0.1",
  "description": "An extension to add UI to Youtube for judging YoYo performances.",
  "author": "<evan@good-meowning.com>",
  "scripts": {
    "dev-c": "plasmo dev --target=chrome-mv3 --verbose",
    "dev-f": "plasmo dev --target=firefox-mv2 --verbose",
    "dev-f3": "plasmo dev --target=firefox-mv3 --verbose",
    "run-c": "web-ext --source-dir='./build/chrome-mv3-dev' run --target='chromium' --verbose --devtools",
    "run-f": "web-ext --source-dir='./build/firefox-mv2-dev' run --target='firefox-desktop' --verbose --devtools",
    "run-f3": "web-ext --source-dir='./build/firefox-mv3-dev' run --target='firefox-desktop' --verbose --devtools",
    "build-c": "plasmo build --target=chrome-mv3",
    "build-f": "plasmo build --target=firefox-mv3",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.9.3",
    "plasmo": "0.84.2",
    "svelte": "4.2.12",
    "svelte-preprocess": "5.1.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.262",
    "@types/firefox": "0.0.34",
    "@types/node": "20.11.24",
    "prettier": "3.2.5",
    "typescript": "5.3.3",
    "web-ext": "^7.11.0"
  },
  "manifest": {
    "browser_specific_settings": {
      "gecko": {
        "id": "your-id@example.com"
      }
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'"
    },
    "host_permissions": [
      "https://*.youtube.com/*"
    ],
    "permissions": [
      "activeTab",
      "scripting",
      "storage",
      "tabs",
      "webNavigation"
    ]
  }
}
